# ONE file for the whole project. Copy to .env, fill in, then run:  npm run env
# (that copies the right values into the website and the app)

# ── Supabase (Project settings > API) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Server only. Never put this in the app. Used by the payment routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Website address (no trailing slash). Local: http://localhost:3000. Live: your Vercel/own domain ──
SITE_URL=http://localhost:3000

# ── Payments: ONE switch ──  test | paystack | flutterwave
PAYMENT_PROVIDER=test
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you type in Flutterwave dashboard > Settings > Webhooks
FLUTTERWAVE_SECRET_HASH=
